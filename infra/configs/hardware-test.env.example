# Template for the ON-SITE test agent. Do not source with unreviewed contents.
# Copy to a local, untracked environment file and substitute the real serial/path.
TELESCO_PI_ENVIRONMENT=test
TELESCO_PI_DEVICE_MODE=configured
TELESCO_PI_CAMERA_DRIVER=player_one
TELESCO_PI_PLAYER_ONE_SDK_ROOT=/opt/telesco-pi/.local-sdk/player-one/PlayerOne_Camera_SDK_Linux_V3.10.1
TELESCO_PI_PLAYER_ONE_BIT_DEPTH=16
TELESCO_PI_CAMERA_ID=REPLACE_WITH_ACTUAL_SERIAL
TELESCO_PI_MOUNT_DRIVER=skywatcher_udp
TELESCO_PI_MOUNT_HOST=192.168.4.1
TELESCO_PI_MOUNT_PORT=11880
TELESCO_PI_MOUNT_MAX_STEP_DEG=0.1
TELESCO_PI_MOUNT_MOTION_ENABLED=false
TELESCO_PI_DEVICE_TIMEOUT_SECONDS=2
TELESCO_PI_DATA_DIR=/var/lib/telesco-pi-hardware-tests/REPLACE_WITH_RUN_ID
TELESCO_PI_AUTO_RESTORE_LAST_SESSION=false
# Never set these until the operator approves CAMERA tests for this run.
# TELESCO_PI_RUN_HARDWARE_CAMERA=1
# TELESCO_PI_HARDWARE_EVIDENCE_DIR=/absolute/path/to/new/run/camera
