TELESCO_PI_ENVIRONMENT=production
TELESCO_PI_DATA_DIR=/var/lib/telesco-pi
# Safe default: no physical devices are opened automatically.
TELESCO_PI_DEVICE_MODE=simulator
# When using the reviewed Nginx LAN template:
# TELESCO_PI_TRUSTED_HOSTS=["localhost","127.0.0.1","telesco-pi.local"]

# To use independently selected drivers, set DEVICE_MODE=configured.
# TELESCO_PI_DEVICE_MODE=configured
# TELESCO_PI_MOUNT_DRIVER=skywatcher_udp
# TELESCO_PI_MOUNT_HOST=192.168.4.1
# TELESCO_PI_MOUNT_PORT=11880
# TELESCO_PI_MOUNT_MAX_STEP_DEG=1
# TELESCO_PI_MOUNT_MOTION_ENABLED=false
# TELESCO_PI_DEVICE_TIMEOUT_SECONDS=2
# TELESCO_PI_CAMERA_DRIVER=nncam
# TELESCO_PI_CAMERA_SDK_MODULE=nncam.nncam
# TELESCO_PI_CAMERA_ID=vendor-camera-identifier
# PYTHONPATH=/opt/camera-control-photsat

# Player One Mars-M/Mars-C (not Nncam). Fetch SDK first; no system-wide install needed.
# TELESCO_PI_DEVICE_MODE=configured
# TELESCO_PI_CAMERA_DRIVER=player_one
# TELESCO_PI_PLAYER_ONE_SDK_ROOT=/opt/telesco-pi/.local-sdk/player-one/PlayerOne_Camera_SDK_Linux_V3.10.1
# TELESCO_PI_PLAYER_ONE_BIT_DEPTH=16
# TELESCO_PI_CAMERA_ID=serial-from-read-only-probe
